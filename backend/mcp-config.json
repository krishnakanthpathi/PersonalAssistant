{
  "mcpServers": {
    "memorize": {
      "enabled": true,
      "command": "python3",
      "args": [
        "/Users/krishnakanth/Projects/memorize/main.py"
      ]
    },
    "mcp-mathematics": {
      "enabled": true,
      "command": "uvx",
      "args": [
        "mcp-mathematics"
      ]
    },
    "firecrawl": {
      "enabled": true,
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "process.env.FIRECRAWL_API_KEY",
        "NODE_PATH": "/Users/krishnakanth/Projects/PersonalAssisstent/backend/node_modules"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "~"
      ],
      "enabled": false
    },
    "macsystem-mcp": {
      "enabled": true,
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/aryapandrangi/MacSystem-MCP",
        "macsystem-mcp"
      ]
    }
  }
}